lemma tubeParams_valid : checkTubeSpec tubeParams = true := by decide +kernel

def checkSlabRange (P : TubeSpec) (start : Nat) : Nat → Bool
  | 0     => true
  | n + 1 => checkSlab P start && checkSlabRange P (start + 1) n

lemma checkSlabRange_sound (P : TubeSpec) :
    ∀ (n start : Nat), checkSlabRange P start n = true →
      ∀ k, start ≤ k → k < start + n → checkSlab P k = true
  | 0, _, _, _, hlo, hhi => by omega
  | n + 1, start, h, k, hlo, hhi => by
    unfold checkSlabRange at h
    simp only [Bool.and_eq_true] at h
    by_cases hk : k = start
    · subst hk; exact h.1
    · exact checkSlabRange_sound P n (start + 1) h.2 k (by omega) (by omega)

lemma chainReach12 {s1 s2 : State12} {n1 n2 : Nat}
    (h1 : ∃ e : Fin 12 → ℝ, ValidEnv12 e ∧ s1.Enc B_nat e (alg2Iter caiGameA n1))
    (hs : List Hint12) (hsteps : totalHintSteps hs = n2)
    (h2 : runHintsFast12 B_nat B_LU_nat hs s1 = some s2) :
    ∃ e' : Fin 12 → ℝ, ValidEnv12 e' ∧ s2.Enc B_nat e' (alg2Iter caiGameA (n1 + n2)) := by
  have hnext := runHintsFast12_enc B_nat B_LU_nat B_nat_pos B_LU_nat_pos hs s1 s2 (alg2Iter caiGameA n1) h1 h2
  rwa [hsteps, ← alg2Iter_eq_from] at hnext

