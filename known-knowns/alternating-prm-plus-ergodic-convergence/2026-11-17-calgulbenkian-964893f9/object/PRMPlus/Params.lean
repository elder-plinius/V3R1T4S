lemma reach_00 : ∃ e : Fin 12 → ℝ, ValidEnv12 e ∧ ckpt_00.Enc B_nat e (alg2Iter caiGameA 0) :=
  initState12_enc B_nat U0_nat B_nat_pos B_eq_three_U0

