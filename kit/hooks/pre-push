#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# V3R1T4S pre-push gate: runs kit/errata_lint.py on every outgoing errata package and blocks the push on FAIL.
# Pushes that touch no known-knowns/<family>/<id>/ package pass through untouched.
#
# Install in the ONE clone you file errata from (never globally, never core.hooksPath):
#   ln -sf <kit-checkout>/kit/hooks/pre-push <filing-clone>/.git/hooks/pre-push
# Uninstall: rm <filing-clone>/.git/hooks/pre-push
# Env: ERRATA_LINT=<path to errata_lint.py> (default: next to this hook), ERRATA_LINT_BASE=<ref> for new branches
# (default: first of upstream/main, origin/main, main).
self=$0
if command -v readlink >/dev/null 2>&1; then
  r=$(readlink -f "$0" 2>/dev/null) && [ -n "$r" ] && self=$r
fi
LINT=${ERRATA_LINT:-$(dirname "$self")/../errata_lint.py}
if [ ! -f "$LINT" ]; then
  echo "pre-push: errata lint not found at $LINT; blocking the push (set ERRATA_LINT=<path>)" >&2
  exit 1
fi
PY=$(command -v python3 || command -v python)
ZERO=0000000000000000000000000000000000000000
rc=0
while read -r lref lsha rref rsha; do
  [ -z "$lsha" ] && continue
  [ "$lsha" = "$ZERO" ] && continue                      # deleting a remote branch: nothing outgoing
  if [ "$rsha" != "$ZERO" ] && ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    rsha=$ZERO                                         # remote tip unknown locally: fall back to the merge base
  fi
  base=$rsha
  if [ "$base" = "$ZERO" ]; then
    for b in ${ERRATA_LINT_BASE:-} upstream/main origin/main main; do
      if git rev-parse -q --verify "$b^{commit}" >/dev/null 2>&1; then
        mb=$(git merge-base "$b" "$lsha" 2>/dev/null) && [ -n "$mb" ] && base=$mb && break
      fi
    done
  fi
  echo "pre-push: errata lint for $lref -> $rref ($base..$lsha)" >&2
  "$PY" "$LINT" --repo . --git "$base..$lsha" --only-if-errata >&2 || rc=1
done
if [ $rc -ne 0 ]; then
  echo "pre-push: BLOCKED by kit/errata_lint.py. Remove or fix the files above and push again." >&2
fi
exit $rc
